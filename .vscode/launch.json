{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug NestJS",
        "type": "node",
        "request": "launch",
        "args": ["${workspaceFolder}/api-nest/src/main.ts"],
        "runtimeArgs": ["--nolazy", "-r", "ts-node/register", "-r", "tsconfig-paths/register"],
        "sourceMaps": true,
        "cwd": "${workspaceFolder}/api-nest",
        "console": "integratedTerminal",
        "skipFiles": ["<node_internals>/**"]
      }
    ]
}