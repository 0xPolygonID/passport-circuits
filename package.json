{
  "name": "passport-circuits",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npm run test-credential && npm run test-idcard && npm run test-anonaadhaar",
    "test-credential": "FULL_TEST_SUITE=true npx ts-mocha --max-old-space-size=40960 'tests/credential/*.test.ts' --exit",
    "test-anonaadhaar": "npx ts-mocha --max-old-space-size=40960 'tests/anonaadhaar/*.test.ts' --exit",
    "test-idcard": "FULL_TEST_SUITE=true npx ts-mocha --max-old-space-size=40960 'tests/idcard/*.test.ts' --exit",
    "test-utils": "npx ts-mocha --max-old-space-size=40960 'tests/utils/*.test.ts' --exit",
    "build-all": "bash scripts/build/build_credential_circuit.sh",
    "build-credential": "bash scripts/build/build_credential_circuit.sh",
    "build-anonaadhaar": "bash scripts/build/build_anonaadhaar_circuits.sh",
    "integration-credential": "ulimit -s 65520 && npx ts-mocha --max-old-space-size=51200 'scripts/integration/credential/credential.integration.ts' --exit",
    "integration-anonaadhaar": "ulimit -s 65520 && npx ts-mocha --max-old-space-size=51200 'scripts/integration/anonAadhaarV1/anonAadhaarV1.integration.ts' --exit",
    "s3-bucket-credential": "bash scripts/s3-bucket/files_credential_circuits.sh",
    "s3-bucket-anonaadhaar": "bash scripts/s3-bucket/files_anonaadhaar_circuits.sh",
    "generate-credential-circuits": "bash scripts/build/credential_circuit_setup_instances.bash"
  },
