    "@openpassport/zk-email-circuits": "^6.1.2",
    "@types/chai": "4.3.11",
    "@types/chai-as-promised": "^7.1.6",
    "@types/circomlibjs": "^0.1.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "@types/node-forge": "^1.3.11",
    "@types/snarkjs": "^0.7.9",
    "chai": "^4.3.8",
    "circomlibjs": "^0.1.7",
    "mocha": "^10.3.0",
    "prettier": "^3.5.3",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@iden3/js-crypto": "^1.3.0",
    "@openpassport/zk-kit-imt": "^0.0.5",
    "@openpassport/zk-kit-lean-imt": "^0.0.6",
    "@openpassport/zk-kit-smt": "^0.0.1",
    "@zk-email/circuits": "^6.3.2",
    "@zk-email/helpers": "^6.4.2",
    "@zk-email/zk-regex-circom": "^2.3.2",
    "@zk-kit/binary-merkle-root.circom": "^1.0.0",
    "@zk-kit/circuits": "^1.0.0-beta",
    "asn1": "^0.2.6",
    "asn1.js": "^5.4.1",
    "asn1js": "^3.0.5",
    "circom_tester": "github:remicolin/circom_tester#main",
    "circom-bigint": "https://github.com/0xbok/circom-bigint",
    "circom-dl": "https://github.com/distributed-lab/circom-dl",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "dotenv": "^16.4.7",
