{
  "name": "passport-circuits",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test-dsc": "npx ts-mocha --max-old-space-size=51200 'tests/dsc/dsc.test.ts' --exit",
    "test-signature": "npx ts-mocha --max-old-space-size=40960 'tests/signature/signature.test.ts' --exit",
    "test-credential": "npx ts-mocha --max-old-space-size=40960 'tests/credential/credential.test.ts' --exit",
    "build-all": "bash scripts/build/build_dsc_circuits.sh && bash scripts/build/build_signature_circuits.sh && bash scripts/build/build_credential_circuit.sh",
    "build-dsc": "bash scripts/build/build_dsc_circuits.sh",
    "build-signature": "bash scripts/build/build_signature_circuits.sh",
    "build-credential": "bash scripts/build/build_credential_circuit.sh",
    "package-all": "bash scripts/package/package_dsc_circuits.sh && bash scripts/package/package_signature_circuits.sh",
    "package-dsc": "bash scripts/package/package_dsc_circuits.sh",
    "package-signature": "bash scripts/package/package_signature_circuits.sh",
    "integration-dsc": "ulimit -s 65520 && npx ts-mocha --max-old-space-size=51200 'scripts/integration/dsc/dsc.integration.ts' --exit",
    "integration-signature": "ulimit -s 65520 && npx ts-mocha --max-old-space-size=51200 'scripts/integration/signature/signature.integration.ts' --exit",
    "integration-credential": "ulimit -s 65520 && npx ts-mocha --max-old-space-size=51200 'scripts/integration/credential/credential.integration.ts' --exit",    
    "s3-bucket-dsc": "bash scripts/s3-bucket/files_dsc_circuits.sh",
    "s3-bucket-signature": "bash scripts/s3-bucket/files_signature_circuits.sh",
    "s3-bucket-credential": "bash scripts/s3-bucket/files_credential_circuits.sh",
    "generate-credential-circuits": "bash scripts/build/credential_circuit_setup_instances.bash"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
