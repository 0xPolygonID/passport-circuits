    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "@types/node-forge": "^1.3.11",
    "@types/snarkjs": "^0.7.9",
    "chai": "^4.3.8",
    "circomlibjs": "^0.1.7",
    "mocha": "^10.3.0",
    "prettier": "^3.5.3",
